<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:iot2="http://schemas.microsoft.com/appx/manifest/iot/windows10/2"
  IgnorableNamespaces="uap mp uap5 desktop iot2">

  <!-- MSIX manifest skeleton (task A). Publisher/Identity are placeholders
       until the signing certificate is issued. -->
  <Identity Name="TransFrame"
            Version="1.0.4.0"
            Publisher="CN=TransFrame Placeholder"
            ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>TransFrame</DisplayName>
    <PublisherDisplayName>TransFrame Team</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.00.UWPDesktop" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" MinVersion="14.0.30704.0" />
  </Dependencies>

  <Applications>
    <Application Id="App"
                 Executable="TransFrame.App.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="TransFrame"
                         Description="Screen translation tool"
                         BackgroundColor="transparent"
                         Square150x150Logo="Assets\Square150x150Logo.png"
                         Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Run at startup (PRD §8: 开机自启动) -->
        <desktop:Extension Category="windows.startupTask"
                            Executable="TransFrame.App.exe"
                            EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="TransFrameStartup"
                                Enabled="false"
                                DisplayName="TransFrame" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities" Name="runFullTrust" />
    <!-- Screen capture via Windows.Graphics.Capture requires neither
         camera nor microphone; the graphicsCapture dialog suffices. -->
    <rescap:Capability xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities" Name="graphicsCaptureProgrammatic" />
    <rescap:Capability xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities" Name="graphicsCaptureWithoutBorder" />
  </Capabilities>
</Package>
