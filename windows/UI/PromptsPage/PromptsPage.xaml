<?xml version="1.0" encoding="utf-8"?>
<!-- PromptsPage.xaml — 「Prompt」页签（settings-spec-mac-parity.md §3，mac 1:1）。
     根元素 UserControl（嵌入 NavigationView Content），x:Class 对应
     winrt::TransFrame::UI::implementation::PromptsPage。
     样式：全部使用 WinUI 3 内置 Fluent 默认样式与 ThemeResource；
     本页无需任何自定义主题资源文件，无需在 App.xaml 合并 ResourceDictionary。
     绑定约定：动态状态（铅笔标记 / 小节可见性）用 Mode="OneWay" +
     code-behind 调 Bindings().Update() 手动刷新（VM 为普通 C++ 类、无 INPC）；
     静态文本（引擎名 / 默认模板预览）保持默认 OneTime。 -->
<UserControl
    x:Class="TransFrame.UI.PromptsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- spec §0：detail 区 StackPanel spacing 20，水平 padding 24 / 顶部 24 / 底部 36 -->
            <StackPanel Spacing="20" Padding="24,24,24,36">

                <!-- ==================== 卡片 1：引擎 Prompt（spec §3.1） ==================== -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,12,16,16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="引擎 Prompt" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="为不同引擎设置自定义翻译 Prompt，未设置时使用默认模板。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <!-- 行顺序固定 openai / claude / gemini / ollama（spec §3.1）。
                             每行：FontIcon 图标 + 引擎名 + 铅笔标记（已设置自定义时）+ 编辑按钮。
                             Tag 存引擎 rawValue，handler 经 Core translationEngineFromRaw 解析。
                             图标为 Segoe Fluent Icons；如需品牌图标在集成时替换 Glyph 即可。 -->
                        <Grid ColumnSpacing="12" Padding="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- E8BD Chat（LLM 对话语义，代表 openai） -->
                            <FontIcon Grid.Column="0" FontSize="16" Glyph="&#xE8BD;"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{x:Bind EngineDisplayName(0)}"/>
                            <!-- E70F Edit：已设置自定义 Prompt 的铅笔标记 -->
                            <FontIcon Grid.Column="2" FontSize="14" Glyph="&#xE70F;"
                                      Visibility="{x:Bind EngineHasCustomPrompt(0), Mode=OneWay}"
                                      ToolTipService.ToolTip="已设置自定义 Prompt"/>
                            <Button Grid.Column="3" Content="编辑" Tag="openai" Click="OnEditEnginePrompt"/>
                        </Grid>

                        <Grid ColumnSpacing="12" Padding="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- E77B Contact（助手语义，代表 claude） -->
                            <FontIcon Grid.Column="0" FontSize="16" Glyph="&#xE77B;"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{x:Bind EngineDisplayName(1)}"/>
                            <FontIcon Grid.Column="2" FontSize="14" Glyph="&#xE70F;"
                                      Visibility="{x:Bind EngineHasCustomPrompt(1), Mode=OneWay}"
                                      ToolTipService.ToolTip="已设置自定义 Prompt"/>
                            <Button Grid.Column="3" Content="编辑" Tag="claude" Click="OnEditEnginePrompt"/>
                        </Grid>

                        <Grid ColumnSpacing="12" Padding="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- E735 FavoriteStar（星形，代表 gemini） -->
                            <FontIcon Grid.Column="0" FontSize="16" Glyph="&#xE735;"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{x:Bind EngineDisplayName(2)}"/>
                            <FontIcon Grid.Column="2" FontSize="14" Glyph="&#xE70F;"
                                      Visibility="{x:Bind EngineHasCustomPrompt(2), Mode=OneWay}"
                                      ToolTipService.ToolTip="已设置自定义 Prompt"/>
                            <Button Grid.Column="3" Content="编辑" Tag="gemini" Click="OnEditEnginePrompt"/>
                        </Grid>

                        <Grid ColumnSpacing="12" Padding="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- E8F1 Library（本地库语义，代表 ollama） -->
                            <FontIcon Grid.Column="0" FontSize="16" Glyph="&#xE8F1;"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{x:Bind EngineDisplayName(3)}"/>
                            <FontIcon Grid.Column="2" FontSize="14" Glyph="&#xE70F;"
                                      Visibility="{x:Bind EngineHasCustomPrompt(3), Mode=OneWay}"
                                      ToolTipService.ToolTip="已设置自定义 Prompt"/>
                            <Button Grid.Column="3" Content="编辑" Tag="ollama" Click="OnEditEnginePrompt"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== 卡片 2：兼容引擎 Prompt（spec §3.2） ====================
                     仅当 VM 兼容实例列表非空时显示（Visibility 绑定；列表由 shell 注入，
                     行在 code-behind RebuildCompatibleRows() 按 displayName 动态生成，
                     避免为普通 C++ 对象引入 XAML DataTemplate 绑定）。 -->
                <Border x:Name="CompatibleCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,12,16,16"
                        Visibility="{x:Bind CompatibleSectionVisible(), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="兼容引擎 Prompt" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="为 OpenAI 兼容实例设置自定义翻译 Prompt。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <!-- 动态行宿主：行元素由 PromptsPage.cpp 构建（E71B Link 图标 + displayName + 铅笔 + 编辑） -->
                        <StackPanel x:Name="CompatibleRowsHost" Spacing="10" Padding="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ==================== 卡片 3：场景 Prompt（spec §3.3） ====================
                     顺序 screenshot / text_selection / translate_and_insert（CoreModels.hpp
                     translationSceneRaw）。Tag 存场景 rawValue，handler 经 Core
                     translationSceneFromRaw 解析。 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,12,16,16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="场景 Prompt" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="按使用场景覆盖 Prompt，优先级高于引擎级与默认模板。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>

                        <Grid ColumnSpacing="12" Padding="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- E722 Camera：截图翻译 -->
                            <FontIcon Grid.Column="0" FontSize="16" Glyph="&#xE722;"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{x:Bind SceneDisplayName(0)}"/>
                            <FontIcon Grid.Column="2" FontSize="14" Glyph="&#xE70F;"
                                      Visibility="{x:Bind SceneHasCustomPrompt(0), Mode=OneWay}"
                                      ToolTipService.ToolTip="已设置自定义 Prompt"/>
                            <Button Grid.Column="3" Content="编辑" Tag="screenshot" Click="OnEditScenePrompt"/>
                        </Grid>

                        <Grid ColumnSpacing="12" Padding="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- E8D2 Font：划词翻译 -->
                            <FontIcon Grid.Column="0" FontSize="16" Glyph="&#xE8D2;"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{x:Bind SceneDisplayName(1)}"/>
                            <FontIcon Grid.Column="2" FontSize="14" Glyph="&#xE70F;"
                                      Visibility="{x:Bind SceneHasCustomPrompt(1), Mode=OneWay}"
                                      ToolTipService.ToolTip="已设置自定义 Prompt"/>
                            <Button Grid.Column="3" Content="编辑" Tag="text_selection" Click="OnEditScenePrompt"/>
                        </Grid>

                        <Grid ColumnSpacing="12" Padding="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- E710 Add：翻译插入（插入语义） -->
                            <FontIcon Grid.Column="0" FontSize="16" Glyph="&#xE710;"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{x:Bind SceneDisplayName(2)}"/>
                            <FontIcon Grid.Column="2" FontSize="14" Glyph="&#xE70F;"
                                      Visibility="{x:Bind SceneHasCustomPrompt(2), Mode=OneWay}"
                                      ToolTipService.ToolTip="已设置自定义 Prompt"/>
                            <Button Grid.Column="3" Content="编辑" Tag="translate_and_insert" Click="OnEditScenePrompt"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== 卡片 4：默认 Prompt 预览（spec §3.4） ====================
                     只读展示；文本来自 Core TranslationPromptConfig::defaultPrompt() /
                     defaultInsertPrompt()（VM 直接调用，不在 UI 层抄写模板文本）。 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,12,16,16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="默认 Prompt 预览" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="只读。自定义 Prompt 保存后按「场景 &gt; 兼容引擎 &gt; 引擎 &gt; 默认」的顺序生效。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="通用（截图 / 划词）"/>
                        <TextBox x:Name="DefaultPromptBox" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="150"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Text="{x:Bind DefaultPromptText()}"/>
                        <TextBlock Text="翻译插入"/>
                        <TextBox x:Name="DefaultInsertPromptBox" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="170"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Text="{x:Bind DefaultInsertPromptText()}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 编辑 Sheet（spec §3.5 PromptEditorSheet） ====================
             ContentDialog 实现：多行 TextBox + 三个模板变量按钮（插入光标处，
             code-behind 操作 TextBox.SelectionStart）+ 取消 / 保存。
             标题在 code-behind 赋值（对话框复用、每次打开目标不同，OneTime x:Bind
             无法跟随，故事件驱动 + code-behind 同步，见 PromptsPage.cpp OpenEditor）。
             [集成点] 对话框 XamlRoot 取页面自身 XamlRoot（WinUI 3 桌面端 ShowAsync 前必须
             赋值）；若宿主窗口有统一 DialogHost 层，可将此 Dialog 移至窗口层托管。 -->
        <ContentDialog x:Name="EditPromptDialog"
                       PrimaryButtonText="保存"
                       CloseButtonText="取消"
                       DefaultButton="Primary"
                       PrimaryButtonClick="OnEditDialogSave">
            <StackPanel Spacing="12" MinWidth="460" MaxWidth="548">
                <TextBlock Text="模板变量（插入到光标处）"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <!-- [待确认] spec §3.5：完整变量清单以 templateVariables 为准。
                     当前保守选择：只提供 Core substitute() 实现的三个变量。 -->
                <!-- 属性值以 {} 开头会被当作标记扩展解析，需用 {} 转义前缀 -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{}{source_language}" FontFamily="Cascadia Mono" Click="OnInsertSourceLanguage"/>
                    <Button Content="{}{target_language}" FontFamily="Cascadia Mono" Click="OnInsertTargetLanguage"/>
                    <Button Content="{}{text}" FontFamily="Cascadia Mono" Click="OnInsertTextToken"/>
                </StackPanel>
                <TextBox x:Name="PromptEditorTextBox"
                         AcceptsReturn="True" TextWrapping="Wrap" IsSpellCheckEnabled="False"
                         Height="280" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PlaceholderText="输入自定义 Prompt 模板"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</UserControl>
