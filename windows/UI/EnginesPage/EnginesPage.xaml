<!-- windows/UI/EnginesPage/EnginesPage.xaml
     FR-35 引擎页签（spec settings-spec-mac-parity.md §2，mac 1:1）。

     自包含 UserControl：不进 XamlTypeInfo（无 .idl），由 shell 直接
     `new tf::ui::EnginesPage()` 实例化后挂 NavigationView content。

     集成合同（主线接入时，见文末注释块）：
       * x:Bind 绑定路径均为 ViewModel.*（页面属性，EnginesPage.xaml.h）；
         编译期要求 shell 项目先编译本 XAML（x:Bind 在 XAML 编译器阶段生成
         到 EnginesPage.xaml.g.h / .xaml.g.cpp，随本文件一起交付）。
       * 需要的资源字典：WinUI 默认 XamlControlsResources（App.xaml 合并
         <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>）
         ——本页只依赖 WinUI 3 内建控件，无额外字典。
       * 命名空间：xmlns:local（本页 code-behind）、xmlns:vm（EngineCards/
         ChainRows 集合绑定在 code-behind 里用 x:Bind 的 ItemsSource 方法
         绑定，见 .h 说明）。
-->
<UserControl
    x:Class="tf::ui::EnginesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,24,24,36" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">

            <!-- ================================================== -->
            <!-- 卡片 A：VLM 配置（spec §2.2 前半：vlm*）            -->
            <!-- ================================================== -->
            <StackPanel>
                <TextBlock Text="VLM 配置" Style="{StaticResource NavigationViewItemHeaderTextStyle}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16"/>
                            <TextBlock Text="视觉语言模型（VLM）用于翻译前图像理解" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ComboBox x:Name="VlmProviderCombo" Header="提供商"
                                  SelectedValuePath="Tag" SelectionChanged="OnVlmProviderChanged"
                                  MinWidth="240" HorizontalAlignment="Left">
                            <ComboBoxItem Content="OpenAI" Tag="openai"/>
                            <ComboBoxItem Content="Claude" Tag="claude"/>
                            <ComboBoxItem Content="Gemini" Tag="gemini"/>
                            <ComboBoxItem Content="Ollama" Tag="ollama"/>
                            <ComboBoxItem Content="PaddleOCR" Tag="paddleocr"/>
                        </ComboBox>

                        <TextBox x:Name="VlmBaseURLBox" Header="Base URL" MinWidth="320"
                                 PlaceholderText="https://api.openai.com/v1"
                                 LostFocus="OnVlmBaseURLCommitted"/>
                        <TextBox x:Name="VlmModelNameBox" Header="模型名" MinWidth="320"
                                 PlaceholderText="gpt-4o"
                                 LostFocus="OnVlmModelNameCommitted"/>

                        <!-- 仅 provider == openai 显示（code-behind 控制 Visibility） -->
                        <ComboBox x:Name="VlmOpenAIModeCombo" Header="OpenAI 接口模式"
                                  SelectedValuePath="Tag" SelectionChanged="OnVlmOpenAIModeChanged"
                                  MinWidth="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Chat Completions" Tag="chat"/>
                            <ComboBoxItem Content="Responses" Tag="responses"/>
                        </ComboBox>

                        <Button Content="保存 VLM 配置" Style="{StaticResource AccentButtonStyle}"
                                Click="OnSaveVlmClick"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================================================== -->
            <!-- 卡片 B：PaddleOCR（spec §2.2 后半）                  -->
            <!-- ================================================== -->
            <StackPanel>
                <TextBlock Text="PaddleOCR" Style="{StaticResource NavigationViewItemHeaderTextStyle}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <!-- 状态行：已安装(版本号) / 未安装 -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="PaddleStatusDot" Width="10" Height="10" Fill="#9E9E9E"/>
                            <TextBlock x:Name="PaddleStatusText" Text="未安装" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ComboBox x:Name="PaddleModeCombo" Header="OCR 模式"
                                  SelectedValuePath="Tag" SelectionChanged="OnPaddleModeChanged"
                                  MinWidth="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="快速（fast，约 1s，行分组）" Tag="fast"/>
                            <ComboBoxItem Content="精准（precise，约 12s，VL-1.5）" Tag="precise"/>
                        </ComboBox>

                        <ToggleSwitch x:Name="PaddleUseCloudToggle" Header="使用云端"
                                      OnContent="开" OffContent="关"
                                      Toggled="OnPaddleUseCloudChanged"/>

                        <!-- useCloud 时显示（code-behind 控制） -->
                        <TextBox x:Name="PaddleCloudBaseURLBox" Header="云端 Base URL" MinWidth="320"
                                 LostFocus="OnPaddleCloudBaseURLCommitted"/>
                        <PasswordBox x:Name="PaddleCloudAPIKeyBox" Header="云端 API Key" MinWidth="320"
                                     PasswordRevealMode="Peek"
                                     PasswordChanged="OnPaddleCloudAPIKeyChanged"/>
                        <TextBox x:Name="PaddleCloudModelIdBox" Header="云端模型 ID" MinWidth="320"
                                 LostFocus="OnPaddleCloudModelIdCommitted"/>

                        <Button Content="保存 PaddleOCR 配置" Click="OnSavePaddleClick"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================================================== -->
            <!-- 卡片 C：多引擎翻译配置（spec §2.3）                  -->
            <!-- ================================================== -->
            <StackPanel>
                <TextBlock Text="多引擎翻译" Style="{StaticResource NavigationViewItemHeaderTextStyle}" Margin="0,0,0,8"/>

                <!-- C-1 策略：ordered / compare（segmented） -->
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="翻译策略"/>
                        <ComboBox x:Name="EngineModeCombo" SelectedValuePath="Tag"
                                  SelectionChanged="OnEngineModeChanged"
                                  MinWidth="260" HorizontalAlignment="Left">
                            <ComboBoxItem Content="顺序回退链（ordered）" Tag="ordered"/>
                            <ComboBoxItem Content="并行对比（compare）" Tag="compare"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- C-2 顺序回退链（ordered 模式） -->
                <Border x:Name="OrderedChainSection" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="顺序回退链" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ChainCountText" Text="1/5" VerticalAlignment="Center" Opacity="0.7"/>
                        </StackPanel>

                        <!-- 链列表：行 = [上移][下移][替换▾][删除] + 引擎名 -->
                        <StackPanel x:Name="ChainListPanel" Spacing="8"/>

                        <MenuFlyoutSeparator/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <!-- “+” 添加 Menu：候选 = isEnabled 内置(排除 custom) + 全部兼容实例 -->
                            <SplitButton x:Name="AddChainButton" Content="添加引擎">
                                <SplitButton.Flyout>
                                    <MenuFlyout x:Name="AddChainMenu"/>
                                </SplitButton.Flyout>
                            </SplitButton>
                            <Button Content="保存链配置" Click="OnSaveChainClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- C-3 并行对比（compare 模式） -->
                <Border x:Name="CompareEnginesSection" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="并行对比引擎" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CompareCountText" Text="2/4" VerticalAlignment="Center" Opacity="0.7"/>
                        </StackPanel>

                        <StackPanel x:Name="CompareListPanel" Spacing="8"/>

                        <MenuFlyoutSeparator/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SplitButton x:Name="AddCompareButton" Content="添加引擎">
                                <SplitButton.Flyout>
                                    <MenuFlyout x:Name="AddCompareMenu"/>
                                </SplitButton.Flyout>
                            </SplitButton>
                            <Button Content="保存对比集" Click="OnSaveCompareClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- C-4 可用引擎卡：9 内置（分组）+ 兼容实例 -->
                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="可用引擎"/>

                        <!-- 分组标题 + 卡片网格（code-behind 动态填充 EngineCardsPanel）：
                             内置 builtIn / LLM / 云服务 cloudService / 兼容 compatible -->
                        <StackPanel x:Name="EngineCardsPanel" Spacing="16"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<!--
  集成注释（主线 shell 接入点，x:Bind 编译期要求）：

  1. 本页所有数据绑定走 code-behind（EnginesPage.xaml.h 的 ViewModel() 属性 +
     x:Bind 的 Initialize()/Loaded 重绑），页面不依赖 XamlTypeInfo 注册——
     UserControl 直接实例化路径（无 .idl）在 C++/WinRT WinUI 3 需要把
     本 XAML 的生成代码（EnginesPage.xaml.g.h）include 进 EnginesPage.xaml.h，
     且 shell 的 App.xaml 必须合并 XamlControlsResources。

  2. 需要的合并资源字典（App.xaml，shell 侧）：
     <ResourceDictionary>
       <ResourceDictionary.MergedDictionaries>
         <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
       </ResourceDictionary.MergedDictionaries>
     </ResourceDictionary>

  3. 挂进 NavigationView（shell 侧示例）：
     navView.ItemInvoked(...) 中 engines 页 →
     contentControl.Content(winrt::make<tf::ui::EnginesPage>());

  4. Page.Resources 里引用的 CardStyle / NavigationViewItemHeaderTextStyle：
     NavigationViewItemHeaderTextStyle 为 WinUI 内建；CardStyle 若 shell 未定义，
     在本页资源缺失时回退为简单 Border（code-behind 已不依赖其存在——XAML 里
     Style="{StaticResource CardStyle}" 需要 shell 资源字典提供，或删除该
     Style 属性改用内联属性；主线接入时按 shell 设计系统二选一）。
-->
