<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- TransFrame.NativeShell static library (merged: task A skeleton base +
       task B capture shell). Depends on: TransFrame.Core. Policy sources are
       portable; Win32/D2D/WGC sources compile only on the Windows platform. -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration><Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration><Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration><Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration><Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{A0000000-0000-0000-0000-00000000000B}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>TransFrame</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <CppWinRTEnabled>true</CppWinRTEnabled>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props"/>

  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseOfMfc>false</UseOfMfc>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props"/>

  <PropertyGroup>
    <OutDir>$(SolutionDir)build\$(Platform)\$(Configuration)\$(ProjectName)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
    <IncludePath>$(ProjectDir)include;$(ProjectDir)..\Core;$(ProjectDir)..\Core\include;$(ProjectDir)..\Core\vendor;$(ProjectDir)..\external;$(IncludePath)</IncludePath>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)$(TargetName).pch</PrecompiledHeaderOutputFile>
      <PreprocessorDefinitions>_UNICODE;UNICODE;WIN32;_WINDOWS;NOMINMAX;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
      <AdditionalOptions>/Zc:__cplusplus /utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Policy sources (portable): no pch, no Win32 includes. -->
  <ItemGroup>
    <ClCompile Include="src\DisplayMonitor.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\WindowDetector.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\HotkeyManager.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\CaptureService.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\OverlayRenderer.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\TrayMenu.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>

  <!-- Windows-only sources: use pch.h. -->
  <ItemGroup>
    <ClCompile Include="src\pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\DisplayMonitorWin32.cpp"/>
    <ClCompile Include="src\WindowDetectorWin32.cpp"/>
    <ClCompile Include="src\HotkeyManagerWin32.cpp"/>
    <ClCompile Include="src\WGCCaptureEngine.cpp"/>
    <ClCompile Include="src\WGCCaptureEngineFull.cpp"/>
    <ClCompile Include="src\DxgiDuplicationEngine.cpp"/>
    <ClCompile Include="src\GdiCaptureEngine.cpp"/>
    <ClCompile Include="src\SelectionOverlay.cpp"/>
    <ClCompile Include="src\TrayIcon.cpp"/>
    <ClCompile Include="src\ResultWindow.cpp"/>
    <ClCompile Include="src\WinHttpTransport.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\CredManKeyStore.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\Win32OcrUiaHosts.cpp"/>
    <ClCompile Include="src\NativeShellInit.cpp"/>
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="include\tf\Geo.hpp"/>
    <ClInclude Include="include\tf\CoreTypes.hpp"/>
    <ClInclude Include="include\tf\DisplayMonitor.hpp"/>
    <ClInclude Include="include\tf\WindowDetector.hpp"/>
    <ClInclude Include="include\tf\CaptureService.hpp"/>
    <ClInclude Include="include\tf\HotkeyManager.hpp"/>
    <ClInclude Include="include\tf\OverlayRenderer.hpp"/>
    <ClInclude Include="include\tf\SelectionOverlay.hpp"/>
    <ClInclude Include="include\tf\TrayIcon.hpp"/>
    <ClInclude Include="include\tf\ResultWindow.hpp"/>
    <ClInclude Include="src\pch.h"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\TransFrame.Core.vcxproj">
      <Project>{A0000000-0000-0000-0000-00000000000A}</Project>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="app.manifest"/>
    <None Include="CMakeLists.txt"/>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets"/>
</Project>
